{
  "name": "schiva-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmarks the schiva JSON Schema validator against ajv and the validators in json-schema-benchmark",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-deprecation isolated.js",
    "suite": "node --no-deprecation isolated.js suite",
    "object": "node --no-deprecation isolated.js object",
    "quick": "pnpm run quick:suite && pnpm run quick:object",
    "quick:suite": "node --no-deprecation suite-bench.js",
    "quick:object": "node --no-deprecation object-bench.js",
    "conformance": "node --no-deprecation conformance.js"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@exodus/schemasafe": "^1.3.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "djv": "^2.1.4",
    "is-my-json-valid": "^2.20.6",
    "jsen": "^0.6.6",
    "json-schema-library": "^11.6.2",
    "json-schema-test-suite": "github:json-schema-org/JSON-Schema-Test-Suite#5b0ee1613e45fcc2bddac00e07c19cd49b00d8a8",
    "jsonschema": "^1.5.0",
    "tinybench": "^6.2.0",
    "tv4": "^1.3.0",
    "z-schema": "^12.4.6"
  }
}
